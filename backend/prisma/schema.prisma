// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Node ESM needs explicit extensions at runtime; without this the generated
  // client emits "./enums" and the compiled output fails with ERR_MODULE_NOT_FOUND.
  importFileExtension = "js"
}

generator erd {
  provider = "prisma-erd-generator"
  output = "../../docs/ERD.md"
}
datasource db {
  provider = "postgresql"
}

model Manufacturer {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cpus    Cpu[]
  gpus    Gpu[]
  systems System[]
}

model Cpu {
  id             Int          @id @default(autoincrement())
  manufacturerId Int
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  name               String
  baseClockGhz       Float
  boostClockGhz      Float?
  passmarkScore      Int?
  eccSupport         Boolean @default(false)
  integratedGraphics Boolean @default(false)
  tdpWatts           Int?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  systemCpus SystemCpu[]
  cpuScore   CpuScore?

  @@index([manufacturerId])
}

model Gpu {
  id             Int          @id @default(autoincrement())
  manufacturerId Int
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  name          String
  vramGb        Int
  passmarkScore Int?
  tdpWatts      Int?
  isIntegrated  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores     GpuScore?
  systemGpus SystemGpu[]

  @@index([manufacturerId])
}

model RamConfig {
  id         Int     @id @default(autoincrement())
  capacityGb Int
  type       String
  eccSupport Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  systemRam SystemRam[]
}

model StorageConfig {
  id         Int    @id @default(autoincrement())
  capacityGb Int
  type       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  systemStorage SystemStorage[]
}

enum OsType {
  windows
  macos
  linux
}

enum Category {
  laptop
  desktop
  workstation
  mini_pc
}

model SystemImage {
  id           Int      @id @default(autoincrement())
  systemId     Int
  system       System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  url          String
  altText      String
  sourceUrl    String
  sourceName   String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([systemId])
}

model System {
  id             Int          @id @default(autoincrement())
  manufacturerId Int
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  name              String
  category          Category
  lengthMm          Int?
  widthMm           Int?
  depthMm           Int?
  screenResolutionX Int?
  screenResolutionY Int?
  weightKg          Float?
  os                OsType
  linuxCompatible   Boolean?
  priceUsd          Float
  releaseYear       Int?
  url               String?
  active            Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  systemCpus    SystemCpu[]
  systemGpus    SystemGpu[]
  systemRam     SystemRam[]
  systemStorage SystemStorage[]
  systemImages  SystemImage[]

  @@index([manufacturerId])
  @@index([category])
}

model SystemCpu {
  id       Int    @id @default(autoincrement())
  systemId Int
  cpuId    Int
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)
  cpu      Cpu    @relation(fields: [cpuId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@index([cpuId])
}

model SystemGpu {
  id       Int    @id @default(autoincrement())
  systemId Int
  gpuId    Int
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)
  gpu      Gpu    @relation(fields: [gpuId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@index([gpuId])
}

model SystemRam {
  id          Int       @id @default(autoincrement())
  systemId    Int
  ramConfigId Int
  system      System    @relation(fields: [systemId], references: [id], onDelete: Cascade)
  ramConfig   RamConfig @relation(fields: [ramConfigId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@index([ramConfigId])
}

model SystemStorage {
  id              Int           @id @default(autoincrement())
  systemId        Int
  storageConfigId Int
  system          System        @relation(fields: [systemId], references: [id], onDelete: Cascade)
  storageConfig   StorageConfig @relation(fields: [storageConfigId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@index([storageConfigId])
}

model CpuScore {
  id    Int @id @default(autoincrement())
  cpuId Int @unique
  cpu   Cpu @relation(fields: [cpuId], references: [id])

  gamingScore       Int?
  productivityScore Int?
  developmentScore  Int?
  cadScore          Int?
}

model GpuScore {
  id    Int @id @default(autoincrement())
  gpuId Int @unique
  gpu   Gpu @relation(fields: [gpuId], references: [id])

  gamingScore    Int?
  aiComputeScore Int?
}

model Question {
  id                Int    @id @default(autoincrement())
  displayText       String
  requirementsField String
  order             Int

  options QuestionOption[]
}

model QuestionOption {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])

  displayText String
  value       String

  @@index([questionId])
}
