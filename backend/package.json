{
  "name": "",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx --env-file=../.env.local src/index.ts",
    "build": "prisma generate && tsc --noEmit -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist/src/index.js && echo '{\"type\":\"module\"}' > dist/package.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:xlsx": "tsx prisma/xlsx-to-csv.ts",
    "db:import": "tsx --env-file=../.env.local prisma/import.ts",
    "db:import:dry": "tsx --env-file=../.env.local prisma/import.ts --dry-run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "esbuild": "0.28.2",
    "exceljs": "^4.4.0",
    "prisma": "^7.10.1",
    "prisma-erd-generator": "^3.2.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "hono": "^4.12.26"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
